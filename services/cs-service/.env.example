NODE_ID=CS
DEPARTMENT=CS
PORT=5001
GRPC_PORT=6001
MONGO_URI=mongodb://localhost:27017/cs_db
JWT_SECRET=replace_with_a_long_random_secret
RABBITMQ_URL=amqp://localhost:5672
HEARTBEAT_INTERVAL_MS=5000

# P2P peer addresses (Phase 3 Step 4) - reuses the same *_SERVICE_URL
# naming convention already established in gateway/.env.example, so
# this department can call its peers directly over HTTP.
IT_SERVICE_URL=http://localhost:5002
ENTC_SERVICE_URL=http://localhost:5003
