# ==========================================================================
# Root reference .env.example - documents every variable used across the
# system. Each service also has its OWN .env.example in its own folder
# (gateway/.env.example, services/cs-service/.env.example, etc) - copy
# each of those to .env in its own folder when running locally.
#
# IMPORTANT: JWT_SECRET must be IDENTICAL across the Gateway and all
# three department services. The Gateway issues the token; each
# department service independently re-verifies it using this same
# secret. If the secrets don't match, every department-service request
# will return 401 Invalid or expired token.
# ==========================================================================

NODE_ENV=development

# ---- Gateway ----
GATEWAY_PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
AUTH_MONGO_URI=mongodb://localhost:27017/auth_db
CS_SERVICE_URL=http://localhost:5001
IT_SERVICE_URL=http://localhost:5002
ENTC_SERVICE_URL=http://localhost:5003
CS_GRPC_ADDRESS=localhost:6001
IT_GRPC_ADDRESS=localhost:6002
ENTC_GRPC_ADDRESS=localhost:6003
RABBITMQ_URL=amqp://localhost:5672

# Heartbeat (Phase 3 Step 3) - Gateway subscribes directly to the
# 'campus.node.heartbeat' fanout exchange, no REST polling involved.
HEARTBEAT_TIMEOUT_MS=15000

# ---- CS Service ----
CS_NODE_ID=CS
CS_DEPARTMENT=CS
CS_PORT=5001
CS_GRPC_PORT=6001
CS_MONGO_URI=mongodb://localhost:27017/cs_db
CS_RABBITMQ_URL=amqp://localhost:5672
CS_HEARTBEAT_INTERVAL_MS=5000

# ---- IT Service ----
IT_NODE_ID=IT
IT_DEPARTMENT=IT
IT_PORT=5002
IT_GRPC_PORT=6002
IT_MONGO_URI=mongodb://localhost:27017/it_db
IT_RABBITMQ_URL=amqp://localhost:5672
IT_HEARTBEAT_INTERVAL_MS=5000

# ---- ENTC Service ----
ENTC_NODE_ID=ENTC
ENTC_DEPARTMENT=ENTC
ENTC_PORT=5003
ENTC_GRPC_PORT=6003
ENTC_MONGO_URI=mongodb://localhost:27017/entc_db
ENTC_RABBITMQ_URL=amqp://localhost:5672
ENTC_HEARTBEAT_INTERVAL_MS=5000
