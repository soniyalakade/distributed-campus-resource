NODE_ENV=development
GATEWAY_PORT=4000
JWT_SECRET=replace_with_a_long_random_secret

AUTH_MONGO_URI=mongodb://localhost:27017/auth_db

CS_SERVICE_URL=http://localhost:5001
IT_SERVICE_URL=http://localhost:5002
ENTC_SERVICE_URL=http://localhost:5003

# gRPC addresses (Phase 3 Step 1) - separate from the REST URLs above,
# used only by the new /api/resources/search-grpc endpoint.
CS_GRPC_ADDRESS=localhost:6001
IT_GRPC_ADDRESS=localhost:6002
ENTC_GRPC_ADDRESS=localhost:6003

# RabbitMQ (Phase 3 Step 2) - used by the Gateway's event subscriber,
# which relays department events to WebSocket clients at /ws/updates.
RABBITMQ_URL=amqp://localhost:5672

# Heartbeat (Phase 3 Step 3) - the Gateway subscribes directly to the
# 'campus.node.heartbeat' fanout exchange and marks a peer DEAD if no
# heartbeat has been seen for this many ms. Department-side publish
# interval (HEARTBEAT_INTERVAL_MS) is configured per-service instead,
# since only the Gateway evaluates the timeout.
HEARTBEAT_TIMEOUT_MS=15000
